include(CMakeFindDependencyMacro)
find_dependency(hip)
find_dependency(BLIS)

if(@ROCBLAS_ENABLE_OPENMP@)
    find_dependency(OpenMP)
endif()

if(@ROCBLAS_ENABLE_MSGPACK@)
    find_dependency(msgpack-cxx CONFIG QUIET)
    if(NOT msgpack-cxx_FOUND)
        find_dependency(msgpackc-cxx CONFIG NAMES msgpackc-cxx msgpack)
    endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/rocblas-targets.cmake")
check_required_components(rocblas)
